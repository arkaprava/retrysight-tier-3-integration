# Tier metadata consumed by CI scripts and Helm defaults.
TIER_SLUG=tier-integration
INSTALLATION_TIER=TIER_3_INTEGRATION
SPRING_PROFILES=docker,tier-integration
IMAGE_PREFIX=retrysight/tier-integration

POSTGRES_DB=agent_retry_integration
